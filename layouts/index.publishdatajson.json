{{- $git := site.Home.GitInfo -}}
{
  "buildTime": "{{ now | time.Format "2006-01-02T15:04:05Z07:00" }}",
  "commitSha": {{ with $git }}"{{ .Hash }}"{{ else }}null{{ end }},
  "commitShort": {{ with $git }}"{{ .AbbreviatedHash }}"{{ else }}null{{ end }},
  "hugoVersion": "{{ hugo.Version }}",
  "environment": "{{ hugo.Environment }}"
}
